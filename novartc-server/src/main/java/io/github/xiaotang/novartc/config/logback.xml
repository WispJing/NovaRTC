<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="60 seconds">

  <!-- ========================================================= -->
  <!-- 1. 基础配置                                                -->
  <!-- ========================================================= -->

  <!-- 日志目录 -->
  <property name="LOG_HOME" value="./logs"/>

  <!-- SpringBoot 控制台颜色支持 -->
  <conversionRule conversionWord="clr"
                  converterClass="org.springframework.boot.logging.logback.ColorConverter"/>


  <!-- ========================================================= -->
  <!-- 2. 日志输出格式                                            -->
  <!-- ========================================================= -->

  <!-- 控制台日志格式（带颜色） -->
  <property name="CONSOLE_PATTERN"
            value="%d{yyyy-MM-dd HH:mm:ss.SSS} %clr(%5level) %clr(${PID:-}){magenta} --- [%thread] %clr(%logger{36}){cyan} - %msg%n"/>

  <!-- 文件日志格式 -->
  <property name="FILE_PATTERN"
            value="%d{yyyy-MM-dd HH:mm:ss.SSS} %5level ${PID:-} --- %logger{36} - %msg%n"/>


  <!-- ========================================================= -->
  <!-- 3. 控制台日志                                              -->
  <!-- ========================================================= -->

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${CONSOLE_PATTERN}</pattern>
    </encoder>
  </appender>


  <!-- ========================================================= -->
  <!-- 4. 系统日志 nova-rtc.log                                   -->
  <!-- ========================================================= -->

  <appender name="FILE"
            class="ch.qos.logback.core.rolling.RollingFileAppender">

    <!-- 当前日志文件 -->
    <file>${LOG_HOME}/nova-rtc.log</file>

    <!-- 滚动策略：按时间 + 文件大小 -->
    <rollingPolicy
        class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

      <!-- 归档文件格式 -->
      <fileNamePattern>
        ${LOG_HOME}/nova-rtc.%d{yyyy-MM-dd}.%i.log
      </fileNamePattern>

      <!-- 单文件最大 -->
      <maxFileSize>100MB</maxFileSize>

      <!-- 保留30天 -->
      <maxHistory>30</maxHistory>

      <!-- 总日志最大容量 -->
      <totalSizeCap>10GB</totalSizeCap>

    </rollingPolicy>

    <encoder>
      <pattern>${FILE_PATTERN}</pattern>
    </encoder>

  </appender>


  <!-- ========================================================= -->
  <!-- 5. ERROR日志 error.log                                     -->
  <!-- 只记录 ERROR 级别日志                                      -->
  <!-- ========================================================= -->

  <appender name="ERROR_FILE"
            class="ch.qos.logback.core.rolling.RollingFileAppender">

    <file>${LOG_HOME}/error.log</file>

    <rollingPolicy
        class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

      <fileNamePattern>
        ${LOG_HOME}/error.%d{yyyy-MM-dd}.%i.log
      </fileNamePattern>

      <maxFileSize>50MB</maxFileSize>
      <maxHistory>30</maxHistory>

    </rollingPolicy>

    <!-- 只接收 ERROR 级别 -->
    <filter class="ch.qos.logback.classic.filter.LevelFilter">
      <level>ERROR</level>
      <onMatch>ACCEPT</onMatch>
      <onMismatch>DENY</onMismatch>
    </filter>

    <encoder>
      <pattern>${FILE_PATTERN}</pattern>
    </encoder>

  </appender>


  <!-- ========================================================= -->
  <!-- 6. Access日志 access.log                                   -->
  <!-- 连接 / 登录 / 断开 / 心跳                                   -->
  <!-- ========================================================= -->

  <appender name="ACCESS_FILE"
            class="ch.qos.logback.core.rolling.RollingFileAppender">

    <file>${LOG_HOME}/access.log</file>

    <rollingPolicy
        class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

      <fileNamePattern>
        ${LOG_HOME}/access.%d{yyyy-MM-dd}.%i.log
      </fileNamePattern>

      <maxFileSize>100MB</maxFileSize>
      <maxHistory>30</maxHistory>

    </rollingPolicy>

    <encoder>
      <pattern>${FILE_PATTERN}</pattern>
    </encoder>

  </appender>


  <!-- ========================================================= -->
  <!-- 7. 消息日志 msg.log                                        -->
  <!-- 聊天消息 / 系统消息 / 群消息                                -->
  <!-- ========================================================= -->

  <appender name="MSG_FILE"
            class="ch.qos.logback.core.rolling.RollingFileAppender">

    <file>${LOG_HOME}/msg.log</file>

    <rollingPolicy
        class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

      <fileNamePattern>
        ${LOG_HOME}/msg.%d{yyyy-MM-dd}.%i.log
      </fileNamePattern>

      <!-- IM消息量大，所以文件稍大 -->
      <maxFileSize>200MB</maxFileSize>
      <maxHistory>30</maxHistory>

    </rollingPolicy>

    <encoder>
      <pattern>${FILE_PATTERN}</pattern>
    </encoder>

  </appender>


  <!-- ========================================================= -->
  <!-- 8. 异步日志 AsyncAppender                                  -->
  <!-- 避免业务线程阻塞IO                                         -->
  <!-- ========================================================= -->

  <!-- 系统日志异步 -->
  <appender name="ASYNC_FILE"
            class="ch.qos.logback.classic.AsyncAppender">

    <queueSize>8192</queueSize>
    <discardingThreshold>0</discardingThreshold>
    <neverBlock>true</neverBlock>

    <appender-ref ref="FILE"/>

  </appender>


  <!-- error日志异步 -->
  <appender name="ASYNC_ERROR"
            class="ch.qos.logback.classic.AsyncAppender">

    <queueSize>2048</queueSize>
    <neverBlock>true</neverBlock>

    <appender-ref ref="ERROR_FILE"/>

  </appender>


  <!-- access日志异步 -->
  <appender name="ASYNC_ACCESS"
            class="ch.qos.logback.classic.AsyncAppender">

    <queueSize>8192</queueSize>
    <discardingThreshold>0</discardingThreshold>
    <neverBlock>true</neverBlock>

    <appender-ref ref="ACCESS_FILE"/>

  </appender>


  <!-- msg日志异步 -->
  <appender name="ASYNC_MSG"
            class="ch.qos.logback.classic.AsyncAppender">

    <queueSize>8192</queueSize>
    <discardingThreshold>0</discardingThreshold>
    <neverBlock>true</neverBlock>

    <appender-ref ref="MSG_FILE"/>

  </appender>


  <!-- ========================================================= -->
  <!-- 9. 业务日志分类                                            -->
  <!-- ========================================================= -->

  <!-- 连接日志 -->
  <logger name="im.access" level="INFO" additivity="false">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="ASYNC_ACCESS"/>
  </logger>

  <!-- 消息日志 -->
  <logger name="im.msg" level="INFO" additivity="false">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="ASYNC_MSG"/>
  </logger>


  <!-- ========================================================= -->
  <!-- 10. Root日志                                               -->
  <!-- ========================================================= -->

  <!-- 默认日志输出 -->
  <root level="INFO">

    <!-- 控制台 -->
    <appender-ref ref="CONSOLE"/>

    <!-- 系统日志 -->
    <appender-ref ref="ASYNC_FILE"/>

    <!-- 错误日志 -->
    <appender-ref ref="ASYNC_ERROR"/>

  </root>

</configuration>
