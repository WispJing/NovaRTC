<?xml version="1.0" encoding="UTF-8"?>
<!--
  Log4j2 控制台版配置文件
  保持原有 logger / appender 结构，改为输出到控制台，便于容器平台统一采集
-->
<Configuration status="WARN" monitorInterval="60">

  <Properties>
    <Property name="LOG_HOME">./logs</Property>
    <Property name="LOG_IM_HOME">./logs/IM</Property>
    <Property name="pid">${pid}</Property>
  </Properties>

  <Appenders>

    <!-- 人类可读控制台日志 -->
    <Console name="CONSOLE" target="SYSTEM_OUT">
      <PatternLayout
          pattern="%d{yyyy-MM-dd HH:mm:ss.SSS}{Asia/Shanghai} %highlight{%5level} %style{%pid}{magenta} --- [%thread] %style{%logger{36}}{cyan} - %msg%n"/>
    </Console>

    <!-- 主系统日志 -->
    <Console name="FILE" target="SYSTEM_OUT">
      <JsonTemplateLayout eventTemplateUri="classpath:log4j2-json-template.json"/>
    </Console>

    <!-- ERROR 专用日志 -->
    <Console name="ERROR_FILE" target="SYSTEM_ERR">
      <JsonTemplateLayout eventTemplateUri="classpath:log4j2-json-template.json"/>
      <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>
    </Console>

    <Console name="IM_APP_FILE" target="SYSTEM_OUT">
      <JsonTemplateLayout eventTemplateUri="classpath:log4j2-json-template.json"/>
    </Console>

    <Console name="IM_ACCESS_FILE" target="SYSTEM_OUT">
      <JsonTemplateLayout eventTemplateUri="classpath:log4j2-json-template.json"/>
    </Console>

    <Console name="IM_MSG_FILE" target="SYSTEM_OUT">
      <JsonTemplateLayout eventTemplateUri="classpath:log4j2-json-template.json"/>
    </Console>

    <Console name="IM_ERROR_FILE" target="SYSTEM_ERR">
      <JsonTemplateLayout eventTemplateUri="classpath:log4j2-json-template.json"/>
      <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>
    </Console>

    <Async name="ASYNC_FILE" bufferSize="8192" blocking="true">
      <AppenderRef ref="FILE"/>
    </Async>

    <Async name="ASYNC_ERROR" bufferSize="8192" blocking="true">
      <AppenderRef ref="ERROR_FILE"/>
    </Async>

    <Async name="IM_ASYNC_APP" bufferSize="8192" blocking="true">
      <AppenderRef ref="IM_APP_FILE"/>
    </Async>

    <Async name="IM_ASYNC_ACCESS" bufferSize="8192" blocking="true">
      <AppenderRef ref="IM_ACCESS_FILE"/>
    </Async>

    <Async name="IM_ASYNC_MSG" bufferSize="8192" blocking="true">
      <AppenderRef ref="IM_MSG_FILE"/>
    </Async>

    <Async name="IM_ASYNC_ERROR" bufferSize="8192" blocking="true">
      <AppenderRef ref="IM_ERROR_FILE"/>
    </Async>

  </Appenders>

  <Loggers>

    <Logger name="im.app" level="INFO" additivity="false">
      <AppenderRef ref="CONSOLE"/>
      <AppenderRef ref="IM_ASYNC_APP"/>
    </Logger>

    <Logger name="im.access" level="INFO" additivity="false">
      <AppenderRef ref="CONSOLE"/>
      <AppenderRef ref="IM_ASYNC_ACCESS"/>
    </Logger>

    <Logger name="im.msg" level="INFO" additivity="false">
      <AppenderRef ref="CONSOLE"/>
      <AppenderRef ref="IM_ASYNC_MSG"/>
    </Logger>

    <Logger name="im.error" level="INFO" additivity="false">
      <AppenderRef ref="CONSOLE"/>
      <AppenderRef ref="IM_ASYNC_ERROR"/>
    </Logger>

    <Root level="INFO">
      <AppenderRef ref="CONSOLE"/>
      <AppenderRef ref="ASYNC_FILE"/>
      <AppenderRef ref="ASYNC_ERROR"/>
    </Root>

  </Loggers>

</Configuration>
