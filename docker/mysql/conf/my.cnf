# MySQL 8.0 配置文件示例
# 文件路径（容器内）：/etc/mysql/conf.d/my.cnf
# 注意：此文件会被 MySQL 默认配置（/etc/mysql/my.cnf）自动包含

[client]
# 客户端默认字符集
default-character-set = utf8mb4
# 连接超时设置（秒）
connect-timeout = 15

[mysql]
# MySQL 命令行客户端默认字符集
default-character-set = utf8mb4
# 提示符格式（可选）
prompt = '\u@\h [\d]> '

[mysqld]
# 字符集设置（必须与 collation 一致）
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci

# 时区（可避免应用层时区转换问题）
default-time-zone = '+00:00'          # 修改为你的时区，如 '+00:00' 为 UTC

# 连接设置
max_connections = 500                  # 最大连接数（根据内存调整）
max_user_connections = 400             # 单个用户最大连接数
wait_timeout = 600                     # 非交互连接超时（秒）
interactive_timeout = 28800             # 交互连接超时（秒）

# 临时表设置
tmp_table_size = 32M                    # 内存临时表最大大小
max_heap_table_size = 32M                # 用户创建的内存表最大大小

# 网络和缓冲区
max_allowed_packet = 64M                 # 最大允许的包大小（用于大字段）
net_buffer_length = 8K                    # 网络通信缓冲大小
read_buffer_size = 2M                      # 顺序读缓冲
read_rnd_buffer_size = 8M                   # 随机读缓冲
sort_buffer_size = 4M                       # 排序缓冲
join_buffer_size = 4M                        # JOIN 缓冲（无索引时）

# 查询缓存（MySQL 8.0 已废弃，保留注释以提醒）
# query_cache_type = 0
# query_cache_size = 0

# 日志设置
log_error = /var/log/mysql/error.log         # 错误日志路径（确保目录存在且可写）
slow_query_log = 1                            # 开启慢查询日志
slow_query_log_file = /var/log/mysql/slow.log  # 慢查询日志文件
long_query_time = 2                            # 慢查询阈值（秒）
log_queries_not_using_indexes = 1              # 记录未使用索引的查询

# InnoDB 存储引擎设置（核心优化）
innodb_buffer_pool_size = 3G                   # 缓冲池大小（设为物理内存的 50%-70%）
innodb_log_file_size = 512M                     # 重做日志文件大小
innodb_log_buffer_size = 64M                     # 重做日志缓冲大小
innodb_flush_log_at_trx_commit = 2               # 事务提交时刷新日志方式（安全与性能平衡：1最安全，2性能好）
innodb_flush_method = O_DIRECT                    # 避免双缓冲（Linux 推荐）
innodb_file_per_table = 1                          # 每个表独立表空间
innodb_io_capacity = 2000                          # I/O 能力（根据磁盘性能调整）
innodb_io_capacity_max = 3000
innodb_read_io_threads = 4
innodb_write_io_threads = 4
innodb_thread_concurrency = 0                      # 0 表示不限制并发线程数
innodb_purge_threads = 4                            # 清理线程数
innodb_page_cleaners = 4                            # 页面清理线程数（与 buffer pool 实例数相关）
innodb_buffer_pool_instances = 8                    # 缓冲池实例数（减少内部锁竞争）

# 安全设置
skip_name_resolve                                   # 禁用 DNS 反向解析（提高性能，但需用 IP 或主机名授权）
# 如果需要在本地使用 socket 认证，可以保留以下设置
# socket = /var/run/mysqld/mysqld.sock               # 通常默认值，无需修改

# 其他常用设置
explicit_defaults_for_timestamp = 1                  # 使 TIMESTAMP 行为更标准
group_concat_max_len = 102400                         # GROUP_CONCAT 最大长度

# 连接控制（防攻击）
max_connect_errors = 100000                            # 最大错误连接数，避免主机被阻塞

# 二进制日志（如果开启主从复制，需配置）
# server-id = 1                                         # 主从复制必须设置唯一 ID
# log_bin = /var/log/mysql/mysql-bin.log                 # 开启二进制日志
# binlog_format = ROW                                    # 推荐 ROW 格式
# expire_logs_days = 7                                    # 日志保留天数（MySQL 8.0 可用 binlog_expire_logs_seconds）
# binlog_expire_logs_seconds = 604800                     # 7 天（秒）

# 性能优化（可选）
# table_open_cache = 2000                                 # 表缓存数
# table_definition_cache = 2000                            # 表定义缓存数
# thread_cache_size = 100                                   # 线程缓存大小